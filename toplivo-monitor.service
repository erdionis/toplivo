[Unit]
Description=Мониторинг заправок Краснодара (toplivo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dio
Group=dio
WorkingDirectory=/home/dio/project/toplivo
ExecStart=/usr/bin/python3 /home/dio/project/toplivo/monitor.py --loop 60
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
