[Unit]
Description=Мониторинг заправок Краснодара (toplivo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erdi
Group=erdi
WorkingDirectory=/mnt/data/toplivo
ExecStart=/usr/bin/python3 /mnt/data/toplivo/monitor.py --loop 60
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
